<odoo>

    <record id="view_dsi_license_list" model="ir.ui.view">
        <field name="name">dsi.license.list</field>
        <field name="model">dsi.license</field>
        <field name="arch" type="xml">
            <list string="Licencias" decoration-danger="state in ('expired', 'revoked')"
                  decoration-warning="state == 'suspended'" decoration-muted="state == 'draft'">
                <field name="key"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="edition" widget="badge"/>
                <field name="rfc_authorized"/>
                <field name="license_type"/>
                <field name="date_end"/>
                <field name="active_instance_count" string="Instancias activas"/>
                <field name="max_instances" string="Cupo"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'suspended'"
                       decoration-danger="state in ('expired', 'revoked')"
                       decoration-muted="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_dsi_license_form" model="ir.ui.view">
        <field name="name">dsi.license.form</field>
        <field name="model">dsi.license</field>
        <field name="arch" type="xml">
            <form string="Licencia">
                <header>
                    <button name="action_activate" type="object" string="Activar" class="btn-primary"
                            invisible="state == 'active'"/>
                    <button name="action_convert_to_subscription" type="object" string="Convertir en suscripción"
                            class="btn-primary" invisible="license_type != 'trial'"
                            confirm="La misma licencia pasa a suscripción por un año, con cupo de 2 instancias. El cliente la recibe en su siguiente renovación diaria, o al momento si pulsa Activar. ¿Continuar?"/>
                    <button name="action_suspend" type="object" string="Suspender"
                            invisible="state != 'active'"/>
                    <button name="action_revoke" type="object" string="Revocar" confirm="¿Revocar esta licencia? Sus bases dejarán de renovarla. Con «Activar» vuelven a renovar sin hacer nada en ellas."
                            invisible="state == 'revoked'"/>
                    <button name="action_reset_to_draft" type="object" string="Regresar a borrador"
                            invisible="state != 'suspended'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="key" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="product_id"/>
                            <field name="edition"/>
                            <field name="token_features"/>
                            <field name="rfc_authorized"/>
                        </group>
                        <group>
                            <field name="license_type"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="max_instances"/>
                            <field name="odoo_versions"/>
                            <field name="sale_reference"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Instancias">
                            <field name="instance_ids">
                                <list editable="bottom" decoration-muted="state == 'inactive'">
                                    <field name="database_uuid" string="UUID de la base"/>
                                    <field name="base_url" string="URL base"/>
                                    <field name="odoo_version" string="Versión de Odoo"/>
                                    <field name="module_version" string="Versión del módulo"/>
                                    <field name="is_production" string="Producción"/>
                                    <field name="date_first_activation" string="Primera activación"/>
                                    <field name="date_last_heartbeat" string="Último heartbeat"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'active'"
                                           decoration-muted="state == 'inactive'"/>
                                    <field name="released_by" optional="show"/>
                                    <button name="action_release" type="object" string="Liberar" icon="fa-times"
                                            invisible="state == 'inactive'"
                                            confirm="¿Liberar esta base? Deja de renovar su licencia y su lugar queda libre para otra. Se deshace con «Reactivar» mientras haya cupo."/>
                                    <button name="action_reactivate" type="object" string="Reactivar" icon="fa-undo"
                                            invisible="state == 'active'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Bitácora">
                            <field name="log_ids" readonly="1">
                                <list>
                                    <field name="create_date" string="Fecha"/>
                                    <field name="endpoint" string="Endpoint"/>
                                    <field name="success" string="Éxito" widget="boolean_toggle"/>
                                    <field name="ip_address" string="Dirección IP"/>
                                    <field name="error_message" string="Mensaje de error"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dsi_license_search" model="ir.ui.view">
        <field name="name">dsi.license.search</field>
        <field name="model">dsi.license</field>
        <field name="arch" type="xml">
            <search string="Buscar licencias">
                <field name="key"/>
                <field name="rfc_authorized"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <filter string="Activas" name="filter_active" domain="[('state', '=', 'active')]"/>
                <filter string="Pruebas" name="filter_trial" domain="[('license_type', '=', 'trial')]"/>
                <filter string="Suspendidas" name="filter_suspended" domain="[('state', '=', 'suspended')]"/>
                <filter string="Expiradas o revocadas" name="filter_ended" domain="[('state', 'in', ('expired', 'revoked'))]"/>
                <separator/>
                <filter string="Bóveda CFDI" name="filter_cfdi_vault" domain="[('product_id.is_cfdi_vault', '=', True)]"/>
                <filter string="Manufactura" name="filter_mrp_manufactura" domain="[('product_id.code', '=', 'mrp_manufactura')]"/>
                <group>
                    <filter string="Producto" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dsi_license" model="ir.actions.act_window">
        <field name="name">Licencias</field>
        <field name="res_model">dsi.license</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_dsi_license_search"/>
    </record>

    <record id="view_dsi_license_product_list" model="ir.ui.view">
        <field name="name">dsi.license.product.list</field>
        <field name="model">dsi.license.product</field>
        <field name="arch" type="xml">
            <list string="Productos licenciables">
                <field name="name"/>
                <field name="code"/>
                <field name="supported_versions"/>
                <field name="features_summary"/>
                <field name="allow_trial"/>
                <field name="trial_days" invisible="not allow_trial"/>
                <field name="license_count"/>
                <field name="purchase_url" widget="url"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_dsi_license_product_form" model="ir.ui.view">
        <field name="name">dsi.license.product.form</field>
        <field name="model">dsi.license.product</field>
        <field name="arch" type="xml">
            <form string="Producto licenciable">
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Ej. Manufactura"/></h1>
                    </div>
                    <group>
                        <group string="Identificación">
                            <field name="code" readonly="license_count"/>
                            <field name="supported_versions"/>
                            <field name="license_count"/>
                        </group>
                        <group string="Prueba de autoservicio">
                            <field name="allow_trial"/>
                            <field name="trial_days" invisible="not allow_trial"/>
                            <field name="trial_edition" invisible="not allow_trial"/>
                        </group>
                    </group>
                    <group string="Funciones que abre el token">
                        <field name="is_cfdi_vault" invisible="1"/>
                        <div class="alert alert-info mb-0" role="alert" colspan="2"
                             invisible="not is_cfdi_vault">
                            Las funciones de la Bóveda CFDI están fijas en código:
                            <strong>Basic</strong>: vault · <strong>Pro</strong>: vault, reconcile.
                            Los clientes ya instalados solo conocen esas.
                        </div>
                        <field name="features_basic" invisible="is_cfdi_vault"
                               placeholder="Ej. mrp_manufactura"/>
                        <field name="features_pro" invisible="is_cfdi_vault"
                               placeholder="Ej. mrp_manufactura"/>
                    </group>
                    <group string="Compra">
                        <field name="purchase_url" widget="url"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dsi_license_product_search" model="ir.ui.view">
        <field name="name">dsi.license.product.search</field>
        <field name="model">dsi.license.product</field>
        <field name="arch" type="xml">
            <search string="Buscar productos">
                <field name="name"/>
                <field name="code"/>
                <filter string="Archivados" name="filter_archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_dsi_license_product" model="ir.actions.act_window">
        <field name="name">Productos licenciables</field>
        <field name="res_model">dsi.license.product</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>

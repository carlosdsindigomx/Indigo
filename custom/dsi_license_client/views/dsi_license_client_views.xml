<odoo>

    <record id="view_dsi_license_client_state_form" model="ir.ui.view">
        <field name="name">dsi.license.client.state.form</field>
        <field name="model">dsi.license.client.state</field>
        <field name="arch" type="xml">
            <form string="Licenciamiento DS Indigo">
                <header>
                    <button name="action_request_trial" type="object" string="Iniciar prueba de 7 días"
                            class="btn-primary"
                            invisible="state != 'not_activated' or trial_state == 'requested'"
                            confirm="Se registrará una prueba de 7 días para el RFC de esta empresa y la dirección de esta base. Solo hay una prueba por RFC. ¿Continuar?"/>
                    <button name="action_refresh" type="object" string="Actualizar"
                            class="btn-primary" invisible="trial_state != 'requested'"/>
                    <button name="action_buy" type="object" string="Comprar licencia" icon="fa-shopping-cart"
                            class="btn-primary" invisible="state not in ('restricted', 'grace')"/>
                    <button name="action_buy" type="object" string="Comprar licencia" icon="fa-shopping-cart"
                            invisible="state not in ('not_activated', 'trial')"/>
                    <button name="action_activate" type="object" string="Activar"
                            invisible="state not in ('not_activated', 'restricted')"/>
                    <button name="action_deactivate" type="object" string="Desactivar"
                            invisible="state not in ('active', 'grace')"
                            confirm="¿Liberar esta instancia en el servidor de licencias? Podrás volver a activarla más tarde."/>
                    <field name="state" widget="statusbar" statusbar_visible="not_activated,trial,active"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Restringido" bg_color="text-bg-danger"
                            invisible="state != 'restricted'"/>
                    <widget name="web_ribbon" title="En gracia" bg_color="text-bg-warning"
                            invisible="state != 'grace'"/>
                    <widget name="web_ribbon" title="En prueba" bg_color="text-bg-info"
                            invisible="state != 'trial'"/>
                    <div class="alert alert-info" role="alert" invisible="trial_state != 'requested'">
                        Verificando esta base con el servidor de licencias de DS Indigo. Tarda menos
                        de un minuto: pulsa <b>Actualizar</b> para ver el resultado.
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="trial_state != 'failed'">
                        No se pudo iniciar la prueba: <field name="trial_error" readonly="1" class="oe_inline"/>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="state not in ('grace', 'restricted')">
                        <field name="status_message" readonly="1" class="oe_inline"/>
                        Mientras tanto no se puede importar, descargar del SAT ni convertir a factura;
                        lo ya guardado se puede consultar y exportar.
                    </div>
                    <group>
                        <group string="Activación">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="activation_url" invisible="1"/>
                            <field name="trial_state" invisible="1"/>
                            <field name="license_key" placeholder="DSI-XXXX-XXXX-XXXX"/>
                        </group>
                        <group string="Estado">
                            <field name="status_message"/>
                            <field name="edition"/>
                            <field name="features"/>
                            <field name="license_end"/>
                            <field name="token_expires"/>
                            <field name="last_check"/>
                            <field name="last_error"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dsi_license_client_state" model="ir.actions.act_window">
        <field name="name">Licenciamiento DS Indigo</field>
        <field name="res_model">dsi.license.client.state</field>
        <field name="view_mode">form</field>
        <field name="res_id" eval="ref('dsi_license_client_state_default')"/>
    </record>

</odoo>

<odoo>

    <record id="view_sat_credential_list" model="ir.ui.view">
        <field name="name">sat.credential.list</field>
        <field name="model">sat.credential</field>
        <field name="arch" type="xml">
            <list string="e.firma" create="0" decoration-danger="state in ('expired', 'revoked')">
                <field name="rfc"/>
                <field name="serial_number"/>
                <field name="date_valid_to"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'validated'"
                       decoration-danger="state in ('expired', 'revoked')"/>
            </list>
        </field>
    </record>

    <record id="view_sat_credential_form" model="ir.ui.view">
        <field name="name">sat.credential.form</field>
        <field name="model">sat.credential</field>
        <field name="arch" type="xml">
            <form string="e.firma" create="0" edit="0">
                <header>
                    <button name="action_revoke" type="object" string="Revocar" class="btn-secondary"
                            invisible="state != 'validated'"
                            confirm="¿Revocar esta e.firma? Se borra la llave privada y la contraseña cifradas; habrá que volver a cargarla para usar Descarga Masiva."/>
                    <field name="state" widget="statusbar" statusbar_visible="validated"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Vencida" bg_color="text-bg-danger" invisible="state != 'expired'"/>
                    <widget name="web_ribbon" title="Revocada" bg_color="text-bg-danger" invisible="state != 'revoked'"/>
                    <div class="oe_title">
                        <h1><field name="rfc" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Certificado">
                            <field name="serial_number" readonly="1"/>
                            <field name="date_valid_from" readonly="1"/>
                            <field name="date_valid_to" readonly="1"/>
                        </group>
                        <group string="Custodia">
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        La llave privada y la contraseña se guardan cifradas — nadie, incluido este
                        formulario, puede volver a verlas en texto plano. Si necesitas cambiar la
                        e.firma, revoca esta y carga la nueva desde el asistente.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sat_credential_import_wizard_form" model="ir.ui.view">
        <field name="name">sat.credential.import.wizard.form</field>
        <field name="model">sat.credential.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Cargar e.firma">
                <p class="text-muted">
                    Sube el certificado (.cer) y la llave privada (.key) de tu e.firma vigente, junto
                    con su contraseña. Se valida que ambos archivos hagan pareja, que la contraseña
                    abra la llave, y que el RFC del certificado coincida con el de esta empresa antes
                    de guardar nada. La llave y la contraseña se cifran de inmediato — nunca se
                    guardan en texto plano.
                </p>
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="cer_filename" invisible="1"/>
                    <field name="cer_file" filename="cer_filename" required="1"/>
                    <field name="key_filename" invisible="1"/>
                    <field name="key_file" filename="key_filename" required="1"/>
                    <field name="password" password="True" required="1"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Validar y guardar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sat_credential" model="ir.actions.act_window">
        <field name="name">e.firma</field>
        <field name="res_model">sat.credential</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_sat_credential_import_wizard" model="ir.actions.act_window">
        <field name="name">Cargar e.firma</field>
        <field name="res_model">sat.credential.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>

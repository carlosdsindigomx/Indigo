<odoo>

    <record id="ir_cron_generar_solicitudes" model="ir.cron">
        <field name="name">Descarga SAT: generar solicitudes del periodo</field>
        <field name="model_id" ref="model_sat_sync_schedule"/>
        <field name="state">code</field>
        <field name="code">model._cron_generar_solicitudes()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_avanzar_solicitudes" model="ir.cron">
        <field name="name">Descarga SAT: verificar y descargar lo que ya esté listo</field>
        <field name="model_id" ref="model_sat_sync_schedule"/>
        <field name="state">code</field>
        <field name="code">model._cron_avanzar_solicitudes()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>

</odoo>

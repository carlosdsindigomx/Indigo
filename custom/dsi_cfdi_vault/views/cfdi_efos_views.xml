<odoo>

    <record id="view_cfdi_efos_entry_list" model="ir.ui.view">
        <field name="name">dsi.cfdi.efos.entry.list</field>
        <field name="model">dsi.cfdi.efos.entry</field>
        <field name="arch" type="xml">
            <list string="Lista 69-B (EFOS)" create="0">
                <field name="rfc"/>
                <field name="name"/>
                <field name="situation" widget="badge"
                       decoration-danger="situation in ('presunto', 'definitivo')"
                       decoration-success="situation in ('desvirtuado', 'sentencia_favorable')"
                       decoration-muted="situation == 'other'"/>
            </list>
        </field>
    </record>

    <record id="view_cfdi_efos_entry_search" model="ir.ui.view">
        <field name="name">dsi.cfdi.efos.entry.search</field>
        <field name="model">dsi.cfdi.efos.entry</field>
        <field name="arch" type="xml">
            <search string="Buscar en la lista 69-B">
                <field name="rfc"/>
                <field name="name"/>
                <filter string="Presuntos" name="filter_presunto" domain="[('situation', '=', 'presunto')]"/>
                <filter string="Definitivos" name="filter_definitivo" domain="[('situation', '=', 'definitivo')]"/>
                <filter string="Desvirtuados" name="filter_desvirtuado" domain="[('situation', '=', 'desvirtuado')]"/>
            </search>
        </field>
    </record>

    <record id="action_cfdi_efos_entry" model="ir.actions.act_window">
        <field name="name">Lista 69-B (EFOS)</field>
        <field name="res_model">dsi.cfdi.efos.entry</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_cfdi_efos_entry_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Todavía no se ha cargado la lista 69-B del SAT.
            </p>
            <p>
                Usa el botón "Cargar lista 69-B" para subir el CSV publicado por el SAT
                (Artículo 69-B del CFF), o configura la URL de descarga automática en
                Ajustes técnicos.
            </p>
        </field>
    </record>

    <record id="view_cfdi_efos_import_wizard_form" model="ir.ui.view">
        <field name="name">dsi.cfdi.efos.import.wizard.form</field>
        <field name="model">dsi.cfdi.efos.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Cargar lista 69-B">
                <p class="text-muted">
                    Sube el CSV de la lista 69-B publicada por el SAT (contribuyentes que
                    facturan operaciones simuladas). La carga <b>reemplaza por completo</b>
                    la lista anterior y recalcula automáticamente el riesgo 69-B de todos
                    los CFDI ya importados.
                </p>
                <group>
                    <field name="csv_filename" invisible="1"/>
                    <field name="csv_file" filename="csv_filename" required="1"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Cargar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cfdi_efos_import_wizard" model="ir.actions.act_window">
        <field name="name">Cargar lista 69-B</field>
        <field name="res_model">dsi.cfdi.efos.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_cfdi_document_efos_risk" model="ir.actions.act_window">
        <field name="name">Proveedores en lista 69-B</field>
        <field name="res_model">cfdi.document</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_efos_risk', '=', True)]</field>
        <field name="search_view_id" ref="view_cfdi_document_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Ningún CFDI con contraparte en la lista 69-B.
            </p>
            <p>
                Aquí aparecerían los CFDI cuyo RFC emisor o receptor está en la lista 69-B
                (Empresas que Facturan Operaciones Simuladas) del SAT.
            </p>
        </field>
    </record>

</odoo>

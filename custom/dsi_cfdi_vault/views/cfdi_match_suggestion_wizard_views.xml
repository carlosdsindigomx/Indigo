<odoo>

    <record id="view_cfdi_match_suggestion_wizard_form" model="ir.ui.view">
        <field name="name">cfdi.match.suggestion.wizard.form</field>
        <field name="model">cfdi.match.suggestion.wizard</field>
        <field name="arch" type="xml">
            <form string="Sugerencias de conciliación">
                <field name="document_id" invisible="1"/>
                <p class="text-muted" invisible="line_ids">
                    No se encontraron facturas candidatas dentro de un rango razonable de fecha
                    y total. Este CFDI queda en la cola de asignación manual: puedes vincularlo
                    a mano desde el campo "Factura" en su formulario, o esperar a que se
                    contabilice la factura correspondiente y volver a intentar la conciliación
                    automática.
                </p>
                <field name="line_ids" invisible="not line_ids">
                    <list create="0" delete="0" edit="0">
                        <field name="move_id" readonly="1"/>
                        <field name="score" readonly="1"/>
                        <field name="rfc_match" readonly="1"/>
                        <field name="amount_diff" readonly="1"/>
                        <field name="date_diff_days" readonly="1"/>
                        <field name="currency_id" column_invisible="1"/>
                        <button name="action_confirm" type="object" string="Vincular" class="btn-primary"/>
                    </list>
                </field>
                <footer>
                    <button string="Cerrar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>

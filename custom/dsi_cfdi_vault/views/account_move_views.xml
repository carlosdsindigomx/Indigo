<odoo>

    <record id="view_move_form_cfdi_vault" model="ir.ui.view">
        <field name="name">account.move.form.cfdi.vault</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_cfdi_documents" type="object" class="oe_stat_button" icon="fa-archive"
                        invisible="not cfdi_document_count">
                    <field name="cfdi_document_count" widget="statinfo" string="CFDI"/>
                </button>
            </div>
        </field>
    </record>

    <record id="view_move_list_no_cfdi" model="ir.ui.view">
        <field name="name">account.move.list.no.cfdi.search</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <filter name="draft" position="after">
                <filter string="Sin CFDI vinculado" name="filter_no_cfdi_document"
                        domain="[('cfdi_document_ids', '=', False), ('move_type', '!=', 'entry')]"/>
            </filter>
        </field>
    </record>

    <record id="action_move_no_cfdi_document" model="ir.actions.act_window">
        <field name="name">Facturas sin CFDI</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('cfdi_document_ids', '=', False), ('move_type', '!=', 'entry'), ('state', '!=', 'cancel')]</field>
        <field name="context">{'search_default_posted': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay facturas sin CFDI de respaldo.
            </p>
        </field>
    </record>

</odoo>
